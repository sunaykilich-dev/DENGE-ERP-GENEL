# Caddy ters vekil — TLS (Let's Encrypt otomatik), güvenlik başlıkları, JSON log.
#
# Kullanım: SUNUCU_ALAN_ADI'nı gerçek alan adıyla değiştirin ve bu dosyayı
# /etc/caddy/Caddyfile olarak kurun. DNS A kaydı bu sunucuya baksın, 80 ve 443
# açık olsun (80 sertifika doğrulaması için gerekli).
#
# Uygulama 127.0.0.1:8000'de dinler ve DIŞARIYA KAPALIDIR (compose port
# eşlemesi 127.0.0.1'e bağlı). Tek giriş kapısı Caddy'dir.

SUNUCU_ALAN_ADI {
	encode gzip

	# Uygulama bu başlıkları kendisi de ekliyor (app/main.py); burada da
	# olması, uygulama yanıt veremediğinde (502/504) bile geçerli kalmalarını
	# sağlar.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Yüklenen Excel dosyaları ve ekler için: varsayılan sınır düşük kalıyor.
	request_body {
		max_size 32MB
	}

	# fail2ban bu logu okur (bkz. deploy/fail2ban/). JSON biçimi şart.
	log {
		output file /var/log/caddy/access.log
		format json
	}

	reverse_proxy 127.0.0.1:8000 {
		# İçe aktarma ve PDF üretimi uzun sürebilir; varsayılan zaman aşımı
		# 2.300 satırlık bir montaj dosyasında yetmiyordu.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}

# Notlar:
# - Teklif public linki (PUBLIC_BASE_URL) bu alan adı olmalı; müşteri
#   /teklif/<jeton> adresini buradan açar.
# - Hız limiti için mholt/caddy-ratelimit içeren bir build gerekir. Yoksa
#   fail2ban ikinci katman olarak kullanılır (deploy/fail2ban/).
