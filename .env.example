# Kopyalayin: cp .env.example .env  ve degerleri doldurun.
#
# ENV=prod verildiginde uygulama ACILISTA bu dosyayi denetler: asagidaki
# yer tutuculardan biri kalmissa ya da sir cok kisaysa BASLAMAZ ve nedenini
# log'a yazar (bkz. app/config.py: uretim_kontrolu). Sessizce calisan ama
# oturum jetonu tahmin edilebilir bir ERP, hic acilmayandan kotudur.
ENV=dev

# Docker Compose kullaniyorsaniz db servisi bu parolayi kullanir.
POSTGRES_PASSWORD=degistir-guclu-bir-parola

# Yerelde backend'i host'ta calistirirken (make api) kullanilan baglanti.
DATABASE_URL=postgresql+psycopg://dengeerp:degistir-guclu-bir-parola@localhost:5432/dengeerp

# openssl rand -hex 32
SECRET_KEY=degistir-openssl-rand-hex-32
# Ayarlar tablosundaki hassas degerlerin sifrelenmesi icin. DEGISTIRILIRSE
# eski sifreli degerler cozulemez ve yeniden girilmeleri gerekir.
SETTINGS_ENC_KEY=degistir-openssl-rand-hex-32

# Teklif public linki (musteri online kabul) bu adrese gore uretilir.
PUBLIC_BASE_URL=http://localhost:5173

# Dosya ekleri, uretilen PDF'ler, ice aktarma hata raporlari.
FILES_DIR=./var/files

# Takip platformundan gelen webhook'un yol jetonu.
WEBHOOK_PATH_TOKEN=degistir-openssl-rand-hex-16

# Iki adimli dogrulama zorunlulugu. VARSAYILAN ACIK: parola dogru olsa da
# kurulum bitmeden hicbir uca erisilemez. Kapatmak mesru bir tercih olabilir
# ama uretimde log'da uyari basilir -- sessiz bir guvenlik dusurmesi olmasin.
MFA_ZORUNLU=true

# Gercek istemci IP'si (TS-211). Caddy host'ta, API konteynerde calisir;
# uvicorn yalniz bu adresten gelen X-Forwarded-For basligina guvenir.
# Docker ag gecidi yazilir; bulmak icin:
#   docker network inspect denge-erp_default -f '{{(index .IPAM.Config 0).Gateway}}'
# Bos birakilirsa 127.0.0.1 kullanilir ve denetim kaydina ag gecidi IP'si duser.
FORWARDED_ALLOW_IPS=172.18.0.1
