# IT HTTPS sertifikasini kurduktan ve SAN adres/hostname eslesmesini onayladiktan sonra kullanin.
# /etc/nginx/sites-available/dengeerp kismina yerlesir; http dosyasinin yerine gecmelidir.
# Kendi sertifika ve anahtar dosyasi yolunu IT belirler.
server {
    listen 10.10.50.16:443 ssl;
    server_name 10.10.50.16;
    ssl_certificate /etc/ssl/dengeerp/erp-fullchain.pem;
    ssl_certificate_key /etc/ssl/dengeerp/erp-privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 20m;
    server_tokens off;
    allow 10.10.50.0/24;
    allow 127.0.0.1;
    deny all;
    location / {
        proxy_pass http://127.0.0.1:5051;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 180s;
    }
}
