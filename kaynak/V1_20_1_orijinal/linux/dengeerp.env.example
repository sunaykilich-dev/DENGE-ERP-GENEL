# /etc/dengeerp/dengeerp.env  - root:root 0600; SQL BAGLANTISINI IT DOLDURUR.
ASPNETCORE_ENVIRONMENT=Production
Urls=http://127.0.0.1:5051
DengeERP__RunDatabaseSetupOnStartup=false
# Veritabani TEST kopyasi olmalidir; Linux icin SQL kullanici/parola (Windows Integrated Auth degil).
# SQL sunucu adini/IP sini, veritabani adini ve kullanici/parolayi IT ile doldurun.
# SQL TLS sertifikasi SQL sunucusunda duzgun kurulmus olmali, CA sunucuda guvenilir olmali.
ConnectionStrings__DengeERP="Server=SQL-SERVER-ADRESI,1433;Database=DengeERP_TEST;User Id=DENGEERP_SQL_USER;Password=DEGISTIR_GUCLU_SIFRE;Encrypt=True;TrustServerCertificate=False;Connect Timeout=15;"
# Yalnizca ONAYLANMIS, yedegi alinmis BOS test DB ilklendirmesinde;
# DengeERP__RunDatabaseSetupOnStartup=true yapin, baslangic sonrasinda geri false yapin.
# DengeERP__InitialAdminPassword="IT_BELIRLESIN_EN_AZ_14_KARAKTER"
